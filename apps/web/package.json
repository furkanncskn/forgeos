{
  "name": "@forgeos/web",
  "version": "0.1.0",
  "private": true,
  "description": "ForgeOS Web UI — React + Vite + TypeScript.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
