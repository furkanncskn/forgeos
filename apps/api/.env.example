# ForgeOS API environment. Copy to .env and adjust as needed.
PORT=3001
HOST=0.0.0.0

# Matches infra/docker-compose.yml.
DATABASE_URL=postgresql://forgeos:forgeos@localhost:5432/forgeos

# Absolute or relative path to the canonical docs folder.
# Default: <repo-root>/docs — only set this to override.
# DOCS_DIR=

# Integration tests (apps/api/test/sync.integration.test.ts) only run when this
# is set. Point it at a DISPOSABLE database — tests truncate tables between runs.
# TEST_DATABASE_URL=postgresql://forgeos:forgeos@localhost:5432/forgeos_test
