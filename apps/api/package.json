{
  "name": "@forgeos/api",
  "version": "0.1.0",
  "private": true,
  "description": "ForgeOS API — Fastify + TypeScript + Drizzle ORM.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "sync": "tsx src/scripts/sync.ts",
    "seed": "tsx src/scripts/seed-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.0",
    "@forgeos/markdown": "workspace:*",
    "@forgeos/types": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.1.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@forgeos/config": "workspace:*",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
