{
  "name": "@forgeos/markdown",
  "version": "0.1.0",
  "private": true,
  "description": "Shared markdown + frontmatter pipeline for ForgeOS: parseDocument(), type inference, plaintext extraction, checksums, reference extraction.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@forgeos/types": "workspace:*",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@forgeos/config": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
